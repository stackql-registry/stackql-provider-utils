{
  "name": "@stackql/provider-utils",
  "version": "0.7.9",
  "description": "Utilities for building StackQL providers from OpenAPI specifications.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": {
      "import": "./src/index.js"
    },
    "./docgen": {
      "import": "./src/docgen/index.js"
    }
  },
  "bin": {
    "provider-dev-utils": "./bin/provider-dev-utils.mjs",
    "docgen-utils": "./bin/docgen-utils.mjs"
  },
  "files": [
    "src/",
    "bin/",
    "LICENSE",
    "README.md",
    ".npmrc"
  ],
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "lint": "eslint src"
  },
  "keywords": [
    "stackql",
    "openapi",
    "infrastructure-as-code",
    "sql",
    "cloud",
    "provider",
    "documentation"
  ],
  "author": "StackQL Studios",
  "license": "MIT",
  "dependencies": {
    "@apidevtools/swagger-parser": "^10.1.1",
    "@stackql/deno-openapi-dereferencer": "npm:@jsr/stackql__deno-openapi-dereferencer@^0.3.1",
    "csv-parser": "^3.2.0",
    "js-yaml": "^4.1.0",
    "pluralize": "^8.0.0"
  },
  "devDependencies": {
    "eslint": "^8.0.0",
    "jest": "^29.0.0"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stackql/stackql-provider-utils.git"
  }
}
